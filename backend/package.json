
{
  "name": "blackout-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend for BLACKOUT",
  "scripts": {
    "dev": "dotenv -e .dev.vars -- wrangler dev --config wrangler.local.jsonc",
    "start": "dotenv -e .dev.vars -- wrangler dev --config wrangler.local.jsonc",
    "deploy": "dotenv -e .dev.vars -- wrangler deploy --config wrangler.local.jsonc",
    "types": "dotenv -e .dev.vars -- wrangler types --config wrangler.local.jsonc",
    "db:init": "dotenv -e .dev.vars -- wrangler d1 execute blackout-db --file=./schema.sql --remote --config wrangler.local.jsonc",
    "db:init:local": "dotenv -e .dev.vars -- wrangler d1 execute blackout-db --file=./schema.sql --local --config wrangler.local.jsonc",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "dotenv -e .dev.vars -- wrangler types --config wrangler.local.jsonc"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.3",
    "@types/node": "^26.6.6",
    "dotenv-cli": "^7.4.0",
    "typescript": "^5.5.2",
    "vitest": "~5.0.3",
    "wrangler": "^4.158.0"
  }
}
