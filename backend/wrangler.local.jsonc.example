/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * IMPORTANT:
 * This is a TEMPLATE. Copy it to `wrangler.local.jsonc` (same
 * directory) and replace `YOUR_D1_DATABASE_ID` with your own
 * Cloudflare D1 database ID.
 *
 * `wrangler.local.jsonc` is gitignored and must never be committed.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "blackout-backend",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-04",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"vars": {
		"SUBSCRIPTION_ENABLED": "false"
	},
	"d1_databases": [
		{
			"binding": "blackout_db",
			"database_name": "blackout-db",
			"database_id": "YOUR_D1_DATABASE_ID"
		}
	]
}